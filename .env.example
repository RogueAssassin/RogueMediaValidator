# RogueMediaValidator 0.7.0 testing - quarantine and deep-validation development
RMV_HTTP_PORT=7811
RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:testing
RMV_DATA_DIR=/data
RMV_NETWORK=media-net

RMV_POLL_SECONDS=2
RMV_LOG_LEVEL=INFO
RMV_DRY_RUN=true

# 0.6.0 administrative Settings are disabled until both values are set.
# Use a strong unique password. These credentials protect /settings and /api/admin/*.
RMV_ADMIN_USERNAME=
RMV_ADMIN_PASSWORD=

# Fresh installs leave the provider blank. Open /setup and select the torrent
# client from the browser. Browser setup persists its connection configuration
# inside RMV's private /data volume.
#
# Advanced/environment-managed installs can set these instead and skip the
# browser wizard:
RMV_TORRENT_CLIENT=
RMV_TORRENT_URL=
RMV_TORRENT_USERNAME=
RMV_TORRENT_PASSWORD=

# Leave blank for one-time automatic scope bootstrap.
# Provider adapters normalize categories, labels and download paths as RMV scopes.
RMV_TORRENT_SCOPES=
RMV_TORRENT_AUTO_BOOTSTRAP_SCOPES=true
RMV_TORRENT_SCOPE_REFRESH_SECONDS=60
RMV_TORRENT_INSPECT_ALL_STATES=true

# Provider adapters normalize download lifecycle states to this common set.
RMV_TORRENT_ACTION_STATES=pausedDL,stoppedDL,downloading,stalledDL,metaDL,queuedDL,checkingDL,forcedDL,allocating,checkingResumeData,moving

# Setup writes lock after first configuration. Temporarily set true and
# recreate RMV only when intentionally reconfiguring from /setup.
RMV_SETUP_UNLOCK=false

RMV_ALLOWED_VIDEO_EXTENSIONS=mkv,mp4,m4v,avi,ts,m2ts,webm,mov
RMV_ALLOWED_SUPPORT_EXTENSIONS=srt,ass,ssa,sub,idx,nfo,jpg,jpeg,png,txt
RMV_BLOCKED_EXTENSIONS=exe,scr,com,bat,cmd,msi,msix,ps1,psm1,vbs,vbe,js,jse,wsf,wsh,lnk,pif,cpl,jar,apk,dll
RMV_MIN_VIDEO_SIZE_MB=50

# 0.7.0 quarantine is opt-in. When true, rejected actionable torrents are
# paused/stopped and held for review instead of being removed.
RMV_QUARANTINE_REJECTED=false

RMV_REMOVE_REJECTED=true
RMV_DELETE_REJECTED_DATA=true
RMV_AUTO_RESUME_VALID=true

