# ==============================================================================
# RogueMediaValidator v1.0.0 - Environment Configuration
# ==============================================================================
#
# Copy this file to ".env" and edit it BEFORE starting RMV:
#
#   cp .env.example .env
#   nano .env
#
# Safe first-install approach:
#   1. Keep RMV_DRY_RUN=true.
#   2. Set a strong RMV_ADMIN_USERNAME / RMV_ADMIN_PASSWORD.
#   3. Make sure RMV_NETWORK matches the container network used by your torrent client.
#   4. Leave RMV_TORRENT_CLIENT / URL / credentials blank to use the browser wizard.
#   5. Start RMV and open http://YOUR-SERVER-IP:7811.
#
# IMPORTANT:
# - Changes to this file require the container to be recreated, not just restarted.
# - Do not share this file publicly when it contains passwords, API keys or tokens.
# ==============================================================================


# ------------------------------------------------------------------------------
# Container / Network
# ------------------------------------------------------------------------------

# Host port used to open the RMV web interface.
# Change this only if port 7811 is already used on the host.
RMV_HTTP_PORT=7811

# Container image to run.
# Testing release candidate:
RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:testing
# Production after v1.0.0 is promoted to main:
# RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:latest

# Internal path where RMV stores its SQLite database and persistent state.
# Normally leave this as /data because compose.yaml mounts the persistent volume here.
RMV_DATA_DIR=/data

# Existing Docker/Podman network shared with the torrent client and integrations.
# Example: media-net
RMV_NETWORK=media-net


# ------------------------------------------------------------------------------
# Runtime / Safety
# ------------------------------------------------------------------------------

# Number of seconds between validation cycles.
# Lower values react faster but poll the torrent-client API more frequently.
RMV_POLL_SECONDS=2

# Application log verbosity.
# Common values: DEBUG, INFO, WARNING, ERROR
RMV_LOG_LEVEL=INFO

# SAFETY SWITCH.
# true  = validate and record decisions, but do not resume/remove/quarantine torrents.
# false = allow configured enforcement actions.
# Keep true during first installation and after major configuration changes.
RMV_DRY_RUN=true


# ------------------------------------------------------------------------------
# Administrator Access
# ------------------------------------------------------------------------------

# Protects /settings and /api/admin/*.
# Both values must be set or administrative Settings remain disabled.
# Use a unique password and do not reuse your torrent-client password.
RMV_ADMIN_USERNAME=
RMV_ADMIN_PASSWORD=


# ------------------------------------------------------------------------------
# Torrent Client
# ------------------------------------------------------------------------------

# Recommended for most users:
# Leave all four values blank and configure the client through the Installation page.
#
# Advanced/environment-managed setup:
# Set RMV_TORRENT_CLIENT to one of:
#   qbittorrent
#   transmission
#   deluge
#   rtorrent
#   aria2
#
# When RMV_TORRENT_CLIENT is set here, environment configuration takes priority
# over browser-saved provider settings.
RMV_TORRENT_CLIENT=

# Torrent client API/Web UI endpoint reachable FROM INSIDE the RMV container.
# Examples:
#   qBittorrent: http://qbittorrent:8080
#   Transmission: http://transmission:9091/transmission/rpc
#   Deluge:       http://deluge:8112/json
#   rTorrent:     http://rutorrent/RPC2
#   aria2:        http://aria2:6800/jsonrpc
RMV_TORRENT_URL=

# Provider username when required.
# aria2 normally leaves this blank and uses RMV_TORRENT_PASSWORD as the RPC secret.
RMV_TORRENT_USERNAME=

# Provider password / API secret when required.
RMV_TORRENT_PASSWORD=


# ------------------------------------------------------------------------------
# Managed Categories / Labels / Download Paths
# ------------------------------------------------------------------------------

# Explicit scopes RMV is allowed to manage.
# Scope meaning depends on the torrent client:
#   qBittorrent  -> categories
#   Transmission -> labels
#   Deluge       -> label or download path
#   rTorrent     -> custom1 label or download path
#   aria2        -> download path
#
# Leave blank for the recommended one-time automatic bootstrap.
# Example explicit value:
# RMV_TORRENT_SCOPES=tv,movies
#
# "*" is an advanced option that manages every non-empty discovered scope.
RMV_TORRENT_SCOPES=

# true = on a fresh install, persist the first non-empty discovered scope set.
# Later newly discovered scopes are visible but are NOT silently enrolled.
RMV_TORRENT_AUTO_BOOTSTRAP_SCOPES=true

# How often RMV refreshes available categories/labels/download paths.
RMV_TORRENT_SCOPE_REFRESH_SECONDS=60

# true = inspect in-scope torrents in all lifecycle states.
# Destructive actions are still limited by RMV_TORRENT_ACTION_STATES.
# false = inspect only torrents currently in an actionable state.
RMV_TORRENT_INSPECT_ALL_STATES=true

# Normalized torrent states in which RMV may resume, quarantine or remove a torrent.
# Completed/seeding/upload-only torrents are intentionally not included.
# Most users should leave this unchanged.
RMV_TORRENT_ACTION_STATES=pausedDL,stoppedDL,downloading,stalledDL,metaDL,queuedDL,checkingDL,forcedDL,allocating,checkingResumeData,moving


# ------------------------------------------------------------------------------
# Installation / Reconfiguration Lock
# ------------------------------------------------------------------------------

# false = lock provider-changing setup actions after configuration.
# true  = temporarily allow browser reconfiguration.
#
# Only set true when intentionally changing the torrent-client connection.
# Recreate the container, make the change, then set this back to false.
RMV_SETUP_UNLOCK=false


# ------------------------------------------------------------------------------
# Validation Policy
# ------------------------------------------------------------------------------

# Video file extensions RMV accepts as media payloads.
# Values are comma-separated and do not include leading dots.
RMV_ALLOWED_VIDEO_EXTENSIONS=mkv,mp4,m4v,avi,ts,m2ts,webm,mov

# Non-video support files allowed alongside valid media.
# Examples include subtitles, metadata and artwork.
RMV_ALLOWED_SUPPORT_EXTENSIONS=srt,ass,ssa,sub,idx,nfo,jpg,jpeg,png,txt

# Extensions that always cause the torrent payload to be rejected.
# Keep executable/script/library types blocked unless you fully understand the risk.
RMV_BLOCKED_EXTENSIONS=exe,scr,com,bat,cmd,msi,msix,ps1,psm1,vbs,vbe,js,jse,wsf,wsh,lnk,pif,cpl,jar,apk,dll

# Minimum size in MiB for at least one approved video file.
# Helps reject fake/tiny payloads that only look like media releases.
RMV_MIN_VIDEO_SIZE_MB=50


# ------------------------------------------------------------------------------
# Rejected Torrent Handling
# ------------------------------------------------------------------------------

# true = pause/stop rejected actionable torrents and retain them for review.
# false = use RMV_REMOVE_REJECTED behavior below.
#
# Quarantine takes precedence over removal when enabled.
RMV_QUARANTINE_REJECTED=false

# true = remove rejected actionable torrent entries when quarantine is disabled.
RMV_REMOVE_REJECTED=true

# true = ask the torrent client to delete downloaded payload data too.
# qBittorrent, Transmission and Deluge support this through their APIs.
# rTorrent/ruTorrent and aria2 cannot guarantee payload deletion; RMV records
# those actions as "limited" instead of pretending cleanup was complete.
RMV_DELETE_REJECTED_DATA=true

# true = automatically resume an approved actionable torrent that is paused/stopped.
# false = validate only; leave approved torrent start state unchanged.
RMV_AUTO_RESUME_VALID=true


# ------------------------------------------------------------------------------
# TV / Movie Automation Integrations
# ------------------------------------------------------------------------------

# Optional provider-neutral feedback for TV/movie automation.
# Leave blank to disable.
#
# Supported providers:
#   radarr  - movie automation
#   sonarr  - TV automation
#   webhook - generic/custom automation
#
# Multiple instances can be configured in the same JSON array.
#
# Radarr + Sonarr example:
# RMV_AUTOMATION_PROVIDERS_JSON='[{"provider":"radarr","name":"Movies","url":"http://radarr:7878","api_key":"CHANGE-ME"},{"provider":"sonarr","name":"TV","url":"http://sonarr:8989","api_key":"CHANGE-ME"}]'
#
# Generic webhook example:
# RMV_AUTOMATION_PROVIDERS_JSON='[{"provider":"webhook","name":"Custom automation","url":"http://automation:9000/rmv","token":"OPTIONAL-TOKEN"}]'
RMV_AUTOMATION_PROVIDERS_JSON=


# ------------------------------------------------------------------------------
# Operational Notifications
# ------------------------------------------------------------------------------

# Optional outbound webhook notifications.
# Leave blank to disable.
#
# Supported event names:
#   approved
#   rejected
#   failed
#   limited
#   quarantined
#
# Example:
# RMV_NOTIFICATION_TARGETS_JSON='[{"provider":"webhook","name":"Ops","url":"http://notifications:9000/rmv","token":"OPTIONAL-TOKEN","events":["rejected","failed","limited","quarantined"]}]'
RMV_NOTIFICATION_TARGETS_JSON=


# ------------------------------------------------------------------------------
# Audit History / Retention
# ------------------------------------------------------------------------------

# Remove validation-history records older than this many days.
# Set to 0 to disable age-based cleanup.
RMV_AUDIT_RETENTION_DAYS=90

# Keep at most this many validation-history records.
# Oldest records are removed first.
# Set to 0 to disable count-based cleanup.
RMV_AUDIT_RETENTION_MAX_RECORDS=10000
