# ==============================================================================
# RogueMediaValidator Default Environment Configuration
# ==============================================================================
#
# RogueMediaValidator deployment directory:
#
#   /opt/media-server/roguemediavalidator
#
# Expected Rogue ecosystem layout:
#
#   /opt/media-server/
#   ├── roguemediavalidator/
#   │   ├── compose.yaml
#   │   ├── .env
#   │   └── update.sh
#   ├── rogueforge/
#   ├── roguedashboard/
#   ├── qbittorrent/
#   ├── radarr/
#   ├── sonarr/
#   └── other Compose stacks...
#
# Copy this file to ".env" if installing manually:
#
#   cd /opt/media-server/roguemediavalidator
#   cp .env.example .env
#   nano .env
#
# IMPORTANT:
# - Keep RMV_DRY_RUN=true until setup and validation behavior are confirmed.
# - RMV_NETWORK must match the network used by the selected torrent client.
# - Changes to this file require the container to be recreated.
# - Do not publish a populated .env containing passwords, API keys or tokens.
# ==============================================================================


# ------------------------------------------------------------------------------
# Deployment / Container
# ------------------------------------------------------------------------------

# Host port used to open RogueMediaValidator directly.
# Container port 7811 remains internal.
RMV_HTTP_PORT=7811

# Container image to run.
# Current testing image:
RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:1.1.0-testing

# Rolling testing alternative:
# RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:testing

# Stable production alternative:
# RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:latest

# Internal persistent-state path INSIDE the container.
# Normally leave this as /data; compose.yaml mounts the named RMV volume here.
RMV_DATA_DIR=/data

# Existing Docker/Podman network shared with the torrent client and integrations.
RMV_NETWORK=media-net


# ------------------------------------------------------------------------------
# Runtime / Safety
# ------------------------------------------------------------------------------

# Seconds between validation cycles.
RMV_POLL_SECONDS=2

# Application log verbosity: DEBUG, INFO, WARNING or ERROR.
RMV_LOG_LEVEL=INFO

# SAFETY SWITCH.
# true  = validate and record decisions without resume/remove/quarantine actions.
# false = allow configured enforcement actions.
# Keep true on first install and after major configuration changes.
RMV_DRY_RUN=true


# ------------------------------------------------------------------------------
# Administrator Access
# ------------------------------------------------------------------------------

# Protects /settings and /api/admin/*.
# Both values must be set or administrative Settings remain disabled.
RMV_ADMIN_USERNAME=
RMV_ADMIN_PASSWORD=


# ------------------------------------------------------------------------------
# Torrent Client
# ------------------------------------------------------------------------------

# Recommended setup:
# Leave these values blank and configure the client through the browser wizard.
#
# Advanced environment-managed providers:
#   qbittorrent
#   transmission
#   deluge
#   rtorrent
#   aria2
#
# Environment configuration takes priority over browser-saved provider settings.
RMV_TORRENT_CLIENT=

# Client API/Web UI endpoint reachable FROM INSIDE the RMV container.
# Examples:
#   qBittorrent:  http://qbittorrent:8080
#   Transmission: http://transmission:9091/transmission/rpc
#   Deluge:       http://deluge:8112/json
#   rTorrent:     http://rutorrent/RPC2
#   aria2:        http://aria2:6800/jsonrpc
RMV_TORRENT_URL=

# Provider username when required.
RMV_TORRENT_USERNAME=

# Provider password, API secret or aria2 RPC secret when required.
RMV_TORRENT_PASSWORD=


# ------------------------------------------------------------------------------
# Managed Categories / Labels / Download Paths
# ------------------------------------------------------------------------------

# Explicit scopes RMV is allowed to manage.
# Scope meaning depends on the provider:
#   qBittorrent  -> categories
#   Transmission -> labels
#   Deluge       -> label or download path
#   rTorrent     -> custom1 label or download path
#   aria2        -> download path
#
# Leave blank for the recommended one-time automatic bootstrap.
# Example: RMV_TORRENT_SCOPES=tv,movies
# Advanced wildcard: RMV_TORRENT_SCOPES=*
RMV_TORRENT_SCOPES=

# Persist the first non-empty discovered scope set on a fresh install.
# Newly discovered scopes are not silently enrolled later.
RMV_TORRENT_AUTO_BOOTSTRAP_SCOPES=true

# Seconds between scope refreshes.
RMV_TORRENT_SCOPE_REFRESH_SECONDS=60

# true = inspect all in-scope torrent lifecycle states.
# Destructive actions still remain limited by RMV_TORRENT_ACTION_STATES.
RMV_TORRENT_INSPECT_ALL_STATES=true

# Normalized states in which RMV may resume, quarantine or remove a torrent.
# Completed/seeding/upload-only torrents are intentionally excluded.
RMV_TORRENT_ACTION_STATES=pausedDL,stoppedDL,downloading,stalledDL,metaDL,queuedDL,checkingDL,forcedDL,allocating,checkingResumeData,moving


# ------------------------------------------------------------------------------
# Installation / Reconfiguration Lock
# ------------------------------------------------------------------------------

# false = lock provider-changing setup actions after configuration.
# true  = temporarily allow browser reconfiguration.
# Return this to false immediately after an intentional provider change.
RMV_SETUP_UNLOCK=false


# ------------------------------------------------------------------------------
# Validation Policy
# ------------------------------------------------------------------------------

# Approved video extensions, comma-separated without leading dots.
RMV_ALLOWED_VIDEO_EXTENSIONS=mkv,mp4,m4v,avi,ts,m2ts,webm,mov

# Support files allowed alongside valid media.
RMV_ALLOWED_SUPPORT_EXTENSIONS=srt,ass,ssa,sub,idx,nfo,jpg,jpeg,png,txt

# Extensions that always reject the payload.
RMV_BLOCKED_EXTENSIONS=exe,scr,com,bat,cmd,msi,msix,ps1,psm1,vbs,vbe,js,jse,wsf,wsh,lnk,pif,cpl,jar,apk,dll

# Minimum approved-video size in MiB.
RMV_MIN_VIDEO_SIZE_MB=50


# ------------------------------------------------------------------------------
# Rejected Torrent Handling
# ------------------------------------------------------------------------------

# true = pause/stop rejected actionable torrents and retain them for review.
# Quarantine takes precedence over removal.
RMV_QUARANTINE_REJECTED=false

# Remove rejected actionable torrent entries when quarantine is disabled.
RMV_REMOVE_REJECTED=true

# Ask supported clients to remove local payload data too.
# rTorrent/ruTorrent and aria2 cannot guarantee this and are reported as limited.
RMV_DELETE_REJECTED_DATA=true

# Automatically resume approved actionable downloads that are paused/stopped.
RMV_AUTO_RESUME_VALID=true


# ------------------------------------------------------------------------------
# TV / Movie Automation Integrations
# ------------------------------------------------------------------------------

# Optional provider-neutral feedback for Radarr, Sonarr or generic webhooks.
# Leave blank to disable.
#
# Example:
# RMV_AUTOMATION_PROVIDERS_JSON='[{"provider":"radarr","name":"Movies","url":"http://radarr:7878","api_key":"CHANGE-ME"},{"provider":"sonarr","name":"TV","url":"http://sonarr:8989","api_key":"CHANGE-ME"}]'
RMV_AUTOMATION_PROVIDERS_JSON=


# ------------------------------------------------------------------------------
# Operational Notifications
# ------------------------------------------------------------------------------

# Optional outbound webhook notifications. Leave blank to disable.
# Events: approved, rejected, failed, limited, quarantined
#
# Example:
# RMV_NOTIFICATION_TARGETS_JSON='[{"provider":"webhook","name":"Ops","url":"http://notifications:9000/rmv","token":"OPTIONAL-TOKEN","events":["rejected","failed","limited","quarantined"]}]'
RMV_NOTIFICATION_TARGETS_JSON=


# ------------------------------------------------------------------------------
# Audit History / Retention
# ------------------------------------------------------------------------------

# Remove validation-history records older than this many days.
# Set to 0 to disable age-based cleanup.
RMV_AUDIT_RETENTION_DAYS=90

# Maximum validation-history records to retain.
# Set to 0 to disable count-based cleanup.
RMV_AUDIT_RETENTION_MAX_RECORDS=10000


# ==============================================================================
# Environment Revision Policy
# ==============================================================================
#
# .env.example is the complete default configuration for a fresh installation.
#
# Existing installations KEEP their current .env.
#
# Only releases introducing NEW runtime environment commands receive a revision
# block. Version-only, documentation-only and container-hardening releases do
# not add meaningless revision markers. This matches RogueDashboard/RogueForge.
#
# Example for a future release that genuinely adds a setting:
#
# ------------------------------------------------------------------------------
# Rev 120 update - RogueMediaValidator v1.2.0
# ------------------------------------------------------------------------------
# RMV_NEW_SETTING=value
#
# update.sh should append only real new commands from such a block.
# ==============================================================================
