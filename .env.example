# RogueMediaValidator 0.3.0 testing - first-run category automation
RMV_HTTP_PORT=7811
RMV_IMAGE=ghcr.io/rogueassassin/roguemediavalidator:testing
RMV_DATA_DIR=/data

RMV_POLL_SECONDS=2
RMV_LOG_LEVEL=INFO

# Safe default. Category auto-bootstrap can occur in dry-run without taking
# resume/delete actions.
RMV_DRY_RUN=true

# qBittorrent Web API endpoint as reachable from the RMV container.
RMV_QB_URL=http://qbittorrent:8080
RMV_QB_USERNAME=admin
RMV_QB_PASSWORD=change-me

# Leave blank for first-run automatic category bootstrap. RMV discovers the
# current non-empty qBittorrent categories, persists that initial set in SQLite,
# and uses them as managed categories.
#
# An explicit value overrides the persisted bootstrap set.
# Use "*" only when every current/future non-empty category should be in scope.
RMV_QB_CATEGORIES=
RMV_QB_AUTO_BOOTSTRAP_CATEGORIES=true
RMV_QB_CATEGORY_REFRESH_SECONDS=60

RMV_QB_INSPECT_ALL_STATES=true

# Resume/delete actions remain restricted to download-lifecycle states.
RMV_QB_ACTION_STATES=pausedDL,stoppedDL,downloading,stalledDL,metaDL,queuedDL,checkingDL,forcedDL,allocating,checkingResumeData,moving

RMV_ALLOWED_VIDEO_EXTENSIONS=mkv,mp4,m4v,avi,ts,m2ts,webm,mov
RMV_ALLOWED_SUPPORT_EXTENSIONS=srt,ass,ssa,sub,idx,nfo,jpg,jpeg,png,txt
RMV_BLOCKED_EXTENSIONS=exe,scr,com,bat,cmd,msi,msix,ps1,psm1,vbs,vbe,js,jse,wsf,wsh,lnk,pif,cpl,jar,apk,dll
RMV_MIN_VIDEO_SIZE_MB=50

RMV_REMOVE_REJECTED=true
RMV_DELETE_REJECTED_DATA=true
RMV_AUTO_RESUME_VALID=true
